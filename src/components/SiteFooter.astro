---
interface Props {
  lang: "de" | "en";
  text: string;
  projectIndexHref?: string;
  projectIndexLabel?: string;
}
const { lang, text, projectIndexHref, projectIndexLabel } = Astro.props;
---
<footer class="kay-site-footer">
  <div class="container kay-site-footer__inner">
    <strong>Kay Löhmann</strong>
    <span>{text}</span>
    {projectIndexHref && projectIndexLabel
      ? <a href={projectIndexHref}>← {projectIndexLabel}</a>
      : <span>© 2026</span>}
  </div>
</footer>

<style>
  .kay-site-footer { padding-block: 32px; border-top: 1px solid var(--line, #dfe2df); color: var(--footer-muted, var(--muted, #606765)); background: #fff; }
  .kay-site-footer__inner { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 28px; font-size: .78rem; }
  .kay-site-footer strong { color: var(--footer-ink, var(--ink, #171b1a)); font-family: var(--display, Georgia, serif); font-weight: 400; }
  .kay-site-footer a { color: inherit; font-weight: 700; text-decoration: none; }
  .kay-site-footer a:hover { color: var(--footer-ink, var(--ink, #162127)); }
  @media (max-width: 800px) {
    .kay-site-footer__inner { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
