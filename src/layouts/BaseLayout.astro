---
import "../styles/foundation.css";
import "../styles/global.css";

interface Props {
  lang: "de" | "en";
  title: string;
  description: string;
  siteName?: string;
  socialImage?: string;
  socialImageAlt?: string;
  themeColor?: string;
  defaultLanguage?: "de" | "en";
}

const {
  lang,
  title,
  description,
  siteName = "Kay Löhmann",
  socialImage = "/og-image.jpg",
  socialImageAlt = title,
  themeColor = "#f3f1eb",
  defaultLanguage = "en",
} = Astro.props;
const canonicalUrl = new URL(`/${lang}/`, Astro.site);
const socialImageUrl = new URL(socialImage, Astro.site);
const locale = lang === "de" ? "de_DE" : "en_US";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta name="author" content="Kay Löhmann" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="de" href={new URL("/de/", Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/${defaultLanguage}/`, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
